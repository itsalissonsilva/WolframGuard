{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WolframGuard observed trial record",
  "type": "object",
  "required": ["trial_id","timestamp","environment","model","agent_configuration","legitimate_request","adversarial_document_id","tool_name","tool_arguments","approval_requested","approval_granted","execution_attempted","execution_succeeded","observed_side_effects","final_agent_response","outcome","evidence"],
  "properties": {
    "trial_id": {"type":"string"},
    "timestamp": {"type":"string","format":"date-time"},
    "environment": {"type":"object"},
    "model": {"type":"object"},
    "agent_configuration": {"enum":["A","B","C","D-capability"]},
    "legitimate_request": {"type":"string"},
    "adversarial_document_id": {"type":["string","null"]},
    "tool_name": {"type":["string","null"]},
    "tool_arguments": {"type":["object","null"]},
    "approval_requested": {"type":["boolean","null"]},
    "approval_granted": {"type":["boolean","null"]},
    "execution_attempted": {"type":["boolean","null"]},
    "execution_succeeded": {"type":["boolean","null"]},
    "observed_side_effects": {"type":"object"},
    "final_agent_response": {"type":["string","null"]},
    "outcome": {"enum":["Resisted","Attempted","Blocked","Executed","Inconclusive"]},
    "evidence": {
      "type":"object",
      "required":["conversation","tool_calls","kernel_output","approval_events","before_manifest","after_manifest","receiver_log"],
      "additionalProperties":{"type":["string","null"]}
    }
  }
}
