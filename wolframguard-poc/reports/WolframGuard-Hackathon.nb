    "], {{0, 800.}, {640., 0}}, {0, 255},
    ColorFunction->RGBColor,
    ImageResolution->{144, 144}],
   BoxForm`ImageTag[
   "Byte", ColorSpace -> "RGB", Interleaving -> True, 
    MetaInformation -> <|
     "Comments" -> {
       "Software" -> "Created with the Wolfram Language : www.wolfram.com", 
